# Beat 3a: the Ledger Sentinel classifying seven real transactions.
# This runs the actual CLI against the actual ruleset. Nothing here is staged:
# the determinations and citations on screen are what the engine produced.
Output video/build/shots/replay.mp4
Set Theme "Catppuccin Mocha"
Set FontSize 16
Set Width 1800
Set Height 1000
Set Padding 30
Set TypingSpeed 45ms
Set PlaybackSpeed 1.0

Type "python3 -m grantloop.replay --pace 1.2"
Sleep 700ms
Enter
Sleep 26s
